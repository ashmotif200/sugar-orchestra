{
  "name": "sugar-orchestra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sugar Orchestra — prototype Muséomix : composition musicale à partir des sons collectés par le visiteur (L'Aventure du Sucre).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5181",
    "typecheck": "tsc -b --noEmit",
    "demo": "npm run build && vite preview --host 0.0.0.0 --port 5181",
    "placeholders": "node scripts/gen-placeholders.mjs",
    "import-assets": "node scripts/import-assets.mjs",
    "admin:serve": "node server/admin-server.mjs",
    "admin:dev": "npm run build && node server/admin-server.mjs",
    "admin:provision": "node scripts/admin/provision.mjs",
    "admin:backup": "node scripts/admin/backup.mjs",
    "admin:apply": "node scripts/admin/apply-publication.mjs",
    "admin:test": "node tests/admin/api.test.mjs",
    "v2:demo": "node scripts/v2/make-demos.mjs",
    "v2:test": "node tests/v2/engine.test.mjs",
    "demo:dev": "vite --host 0.0.0.0 --port 5180"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
